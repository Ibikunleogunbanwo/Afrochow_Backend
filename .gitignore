# ==============================================================================
# AFROCHOW - GIT IGNORE
# ==============================================================================

# ===== SECRETS — NEVER COMMIT =====
.env
.env.*
*.env
!.env.example
!.env.prod.example

# ===== MAVEN BUILD OUTPUT =====
target/
*.jar
*.war
*.ear

# Generated output
output/

tools/
# Marketing assets (if you don't want them in Git)
marketing/

# Documentation (only if you don't want docs tracked)
docs/

# Generated script
tools/create_afrochow_instagram_visuals.py
# ===== IDE FILES =====
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace

# ===== OS FILES =====
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# ===== LOGS =====
*.log
logs/
*.zip
*.tmp

# ===== SPRING BOOT =====
spring.log

# ===== UPLOADS (local dev only) =====
uploads/

# ===== COMPILED CLASSES =====
*.class

# ===== AI / CLAUDE =====
.ai/**
.claude/**
.continue/

# ===== LOCAL DOCS =====
*.docx
*.doc
*.pptx

# Personal job-application materials (resumes, cover letters, rendered
# PDFs/screenshots) — unrelated to the app, never committed.
job_applications/

# ===== NODE / NEXT.JS =====
node_modules/
.next/
out/
dist/

# ===== EDITOR TEMP FILES =====
*.swp
*.swo
*~

# ===== OPTIONAL DB FILES =====
*.sql
!src/main/resources/db/migration/*.sql
*.dump
*.db

# ===== DEPLOYMENT ARTIFACTS =====
backups/
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep

# ===== LOCAL OPERATIONAL DOCS =====
docs/
afrochow_endpoint_audit.xlsx
